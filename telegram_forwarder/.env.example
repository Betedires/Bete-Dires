# ────────────────────────────────────────────────────────────────────────────
# Bete Dires Forwarder — Environment Configuration
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────────────────────────

# ── Telegram API Credentials ─────────────────────────────────────────────────
# Get these from https://my.telegram.org → "API development tools"
API_ID=your_api_id
API_HASH=your_api_hash

# ── Source Groups ─────────────────────────────────────────────────────────────
# Comma-separated list of group usernames or chat IDs to monitor.
# Examples: @MyGroup,@OtherGroup  OR  -100123456789,-100987654321
SOURCE_GROUPS=@YourSourceGroup1,@YourSourceGroup2

# ── Target Channel ────────────────────────────────────────────────────────────
# The hub channel where all approved items are posted.
# Uses CHANNEL_ID from root .env if not set here.
TARGET_GROUP=@BeteDires_Main

# ── Confidence Mode ───────────────────────────────────────────────────────────
# 'strict'  (default): item name + valid price + valid phone ALL required to auto-post.
# 'relaxed': item name + (valid price OR valid phone) is enough to auto-post.
# Anything below threshold is saved as PENDING for admin review.
CONFIDENCE_MODE=strict

# ── Catchup on Startup ────────────────────────────────────────────────────────
# If true, replays messages missed since last_message_id.txt on every start.
# Deduplication via content hash prevents double-posting.
# Set to false if you only want to process new messages going forward.
ENABLE_CATCHUP=true

# ── Session Path ──────────────────────────────────────────────────────────────
# Directory where the Telethon session file is stored.
# Leave blank to use the default (LocalAppData on Windows, ~/.local/share on Linux).
# IMPORTANT: Do NOT point this inside an OneDrive-synced folder.
# SESSION_DIR=/home/youruser/.local/share/BeteDiresBot

# ── Watermark ─────────────────────────────────────────────────────────────────
# Path to a PNG watermark image. Relative to the telegram_forwarder/ directory.
# If the file does not exist, WATERMARK_TEXT is rendered as a text watermark instead.
# WATERMARK_PATH=watermark.png
# WATERMARK_TEXT=Bete Dires

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum seconds to wait on a Telegram FloodWait before giving up.
MAX_FLOOD_WAIT_SECONDS=60
